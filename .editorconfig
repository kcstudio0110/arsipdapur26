# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# JavaScript / TypeScript / React
[*.{js,jsx,ts,tsx}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# HTML
[*.html]
indent_size = 2

# CSS
[*.{css,scss,sass}]
indent_size = 2

# Python
[*.py]
indent_size = 4

# Shell Script
[*.sh]
indent_size = 2

# Dockerfile
[Dockerfile]
indent_size = 2